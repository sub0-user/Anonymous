<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.server.anonymous.controller.ChatController" styleClass="chat-pane">
    <top>
        <VBox spacing="2.0" styleClass="chat-header">
            <Label fx:id="titleLabel" styleClass="chat-title"/>
            <Label fx:id="subtitleLabel" styleClass="status-text"/>
        </VBox>
    </top>
    <center>
        <ListView fx:id="messageList" styleClass="message-list"/>
    </center>
    <bottom>
        <HBox styleClass="composer" spacing="8.0" alignment="CENTER_LEFT">
            <TextField fx:id="draftField" promptText="%chat.composer.prompt" styleClass="composer-field"
                       HBox.hgrow="ALWAYS" onAction="#onSendClicked"/>
            <Button fx:id="sendButton" text="%chat.send" onAction="#onSendClicked" styleClass="accent-button" mnemonicParsing="false"/>
        </HBox>
    </bottom>
</BorderPane>
