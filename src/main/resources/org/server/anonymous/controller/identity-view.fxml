<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.server.anonymous.controller.IdentityController"
      styleClass="identity-view" alignment="TOP_CENTER" spacing="12.0" maxWidth="560.0">
    <ImageView fx:id="logoImage" fitHeight="110.0" preserveRatio="true"/>
    <Label fx:id="appNameLabel" styleClass="identity-title"/>
    <Label fx:id="taglineLabel" styleClass="muted-text"/>

    <VBox styleClass="address-card" spacing="8.0" maxWidth="Infinity">
        <Label text="YOUR NUMBER (SHARE THIS)" styleClass="label-caption"/>
        <HBox alignment="CENTER_LEFT" spacing="8.0">
            <Label fx:id="addressLabel" styleClass="mono" HBox.hgrow="ALWAYS"/>
            <Button text="Copy" onAction="#onCopyAddress" styleClass="accent-button" mnemonicParsing="false"/>
        </HBox>
        <Label text="Node runs locally — nobody else hosts your chat." styleClass="muted-text"/>
    </VBox>

    <HBox alignment="CENTER" spacing="6.0">
        <Circle radius="4.0" styleClass="status-dot"/>
        <Label fx:id="nodeStatusLabel" styleClass="status-text"/>
    </HBox>

    <VBox styleClass="settings-box" spacing="4.0" maxWidth="Infinity">
        <Label text="SETTINGS" styleClass="label-caption"/>
        <Label text="Data directory" styleClass="muted-text"/>
        <Label fx:id="dataDirectoryLabel" styleClass="mono"/>
        <Label fx:id="versionLabel" styleClass="muted-text"/>
    </VBox>
</VBox>
