<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.server.anonymous.controller.IdentityController"
      styleClass="identity-view" alignment="TOP_CENTER" spacing="12.0" maxWidth="Infinity">
    <ImageView fx:id="logoImage" fitHeight="110.0" preserveRatio="true"/>
    <Label text="%app.name" styleClass="identity-title"/>
    <Label text="%app.tagline" styleClass="muted-text"/>

    <VBox styleClass="address-card" spacing="8.0" maxWidth="Infinity">
        <Label text="%identity.your_number" styleClass="label-caption"/>
        <HBox alignment="CENTER_LEFT" spacing="8.0">
            <Label fx:id="addressLabel" styleClass="mono" HBox.hgrow="ALWAYS"
                   minWidth="0.0" maxWidth="Infinity" wrapText="true"/>
            <Button text="%identity.copy" onAction="#onCopyAddress" styleClass="accent-button" mnemonicParsing="false"/>
        </HBox>
        <Label text="%identity.node_local" styleClass="muted-text"/>
    </VBox>

    <HBox alignment="CENTER" spacing="6.0">
        <Circle radius="4.0" styleClass="status-dot"/>
        <Label fx:id="nodeStatusLabel" styleClass="status-text"/>
    </HBox>

    <VBox styleClass="settings-box" spacing="4.0" maxWidth="Infinity">
        <Label text="%identity.settings" styleClass="label-caption"/>
        <Label text="%identity.data_directory" styleClass="muted-text"/>
        <Label fx:id="dataDirectoryLabel" styleClass="mono"/>
        <Label fx:id="versionLabel" styleClass="muted-text"/>
    </VBox>

    <VBox styleClass="settings-box" spacing="4.0" maxWidth="Infinity">
        <Label text="%identity.backup" styleClass="label-caption"/>
        <Label text="%identity.backup.hint" styleClass="muted-text" wrapText="true" maxWidth="Infinity"/>
        <HBox spacing="8.0">
            <Button text="%identity.backup" onAction="#onBackupClicked"
                    styleClass="ghost-button" HBox.hgrow="ALWAYS" maxWidth="Infinity" mnemonicParsing="false"/>
            <Button text="%identity.restore" onAction="#onRestoreClicked"
                    styleClass="ghost-button" HBox.hgrow="ALWAYS" maxWidth="Infinity" mnemonicParsing="false"/>
        </HBox>
        <Label fx:id="backupMessageLabel" styleClass="muted-text" wrapText="true"/>
    </VBox>
</VBox>
