<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.ButtonType?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DialogPane?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<DialogPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.server.anonymous.controller.InviteDialogController" prefWidth="420.0" styleClass="dialog-pane">
    <content>
        <VBox spacing="10.0">
            <VBox spacing="4.0">
                <Label text="%room.invite.contact" styleClass="label-caption"/>
                <ComboBox fx:id="contactBox" styleClass="search-field"/>
            </VBox>
            <VBox spacing="4.0">
                <Label text="%room.invite.name" styleClass="label-caption"/>
                <TextField fx:id="nameField" promptText="%room.invite.name.prompt" styleClass="search-field"/>
            </VBox>
            <HBox spacing="8.0" alignment="CENTER_LEFT">
                <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                    <Label text="%room.invite.expiry" styleClass="label-caption"/>
                    <TextField fx:id="expiryField" promptText="%room.invite.expiry.prompt" styleClass="search-field"/>
                </VBox>
                <Label text="%room.invite.expiry.days" styleClass="muted-text"/>
            </HBox>
            <Label fx:id="inviteLabel" styleClass="mono status-text" wrapText="true"/>
            <Label fx:id="busyLabel" text="%rooms.creating" styleClass="status-text" visible="false" managed="false"/>
            <Label fx:id="feedbackLabel" styleClass="error-text" wrapText="true"/>
        </VBox>
    </content>
    <buttonTypes>
        <ButtonType fx:constant="CANCEL"/>
    </buttonTypes>
</DialogPane>
