<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<HBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" spacing="8.0" alignment="CENTER_LEFT">
    <Label fx:id="nameLabel" styleClass="chat-title" HBox.hgrow="ALWAYS"/>
    <Label fx:id="statusLabel" styleClass="muted-text"/>
    <Button fx:id="renameButton" text="%room.member.rename" styleClass="ghost-button" mnemonicParsing="false"/>
    <Button fx:id="removeButton" text="%room.member.remove" styleClass="ghost-button" mnemonicParsing="false"/>
</HBox>
