<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.DialogPane?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.layout.VBox?>
<!-- Root is a DialogPane: IdentityController assigns this file to dialog.dialogPane,
     so the root element must BE the pane, not a layout box inside it. -->
<DialogPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1">
    <content>
        <VBox spacing="10.0" styleClass="identity-view" maxWidth="420.0">
            <Label fx:id="hintLabel" styleClass="muted-text" wrapText="true"/>
            <PasswordField fx:id="passphraseField" promptText="%dialog.passphrase.prompt"/>
        </VBox>
    </content>
</DialogPane>
