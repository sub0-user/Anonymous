<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.server.anonymous.controller.RequestsController"
      styleClass="identity-view" alignment="TOP_LEFT" spacing="12.0" maxWidth="560.0">
    <Label text="%requests.title" styleClass="identity-title"/>
    <Label fx:id="emptyLabel" text="%requests.empty" styleClass="muted-text"/>
    <Label fx:id="feedbackLabel" styleClass="error-text"/>
    <ListView fx:id="requestList" styleClass="chat-list" VBox.vgrow="ALWAYS"/>
    <HBox spacing="8.0">
        <Button text="%requests.accept" onAction="#onAcceptClicked"
                styleClass="accent-button" HBox.hgrow="ALWAYS" maxWidth="Infinity" mnemonicParsing="false"/>
        <Button text="%requests.ignore" onAction="#onIgnoreClicked"
                styleClass="ghost-button" HBox.hgrow="ALWAYS" maxWidth="Infinity" mnemonicParsing="false"/>
        <Button text="%requests.block" onAction="#onBlockClicked"
                styleClass="ghost-button" HBox.hgrow="ALWAYS" maxWidth="Infinity" mnemonicParsing="false"/>
    </HBox>
</VBox>
