<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.server.anonymous.controller.RoomChatController" styleClass="chat-pane">
    <top>
        <VBox spacing="2.0" styleClass="chat-header">
            <HBox spacing="8.0" alignment="CENTER_LEFT">
                <VBox spacing="2.0" HBox.hgrow="ALWAYS">
                    <Label fx:id="titleLabel" styleClass="chat-title"/>
                    <Label fx:id="subtitleLabel" styleClass="status-text" wrapText="true"/>
                </VBox>
                <Button fx:id="inviteButton" text="%room.add_member" onAction="#onAddMemberClicked"
                        styleClass="ghost-button" mnemonicParsing="false"/>
                <Button fx:id="membersButton" text="%room.members" onAction="#onMembersClicked"
                        styleClass="ghost-button" mnemonicParsing="false"/>
                <Button fx:id="clearHistoryButton" text="%chat.clear_history" onAction="#onClearHistoryClicked"
                        styleClass="ghost-button" mnemonicParsing="false"/>
                <Button fx:id="leaveButton" text="%room.leave" onAction="#onLeaveClicked"
                        styleClass="ghost-button" mnemonicParsing="false"/>
                <Button fx:id="deleteButton" text="%room.delete" onAction="#onDeleteClicked"
                        styleClass="ghost-button" mnemonicParsing="false"/>
            </HBox>
            <Label fx:id="feedbackLabel" styleClass="error-text"/>
            <Label fx:id="inviteFeedbackLabel" styleClass="status-text" wrapText="true"/>
        </VBox>
    </top>
    <center>
        <ListView fx:id="messageList" styleClass="message-list"/>
    </center>
    <bottom>
        <VBox>
            <HBox fx:id="replyBar" styleClass="reply-bar" spacing="8.0" alignment="CENTER_LEFT"
                  visible="false" managed="false">
                <Label fx:id="replyBarLabel" styleClass="muted-text" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                <Button onAction="#onCancelReplyClicked" text="✕" styleClass="ghost-button" mnemonicParsing="false"/>
            </HBox>
            <HBox styleClass="composer" spacing="8.0" alignment="CENTER_LEFT">
                <TextField fx:id="draftField" promptText="%room.composer.prompt" styleClass="composer-field"
                           HBox.hgrow="ALWAYS" onAction="#onSendClicked"/>
                <Button fx:id="emojiButton" text="😊" onAction="#onEmojiClicked"
                        styleClass="ghost-button" mnemonicParsing="false"/>
                <Button text="%chat.send" onAction="#onSendClicked" styleClass="accent-button" mnemonicParsing="false"/>
            </HBox>
        </VBox>
    </bottom>
</BorderPane>
