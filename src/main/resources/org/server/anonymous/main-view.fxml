<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.server.anonymous.controller.MainController" styleClass="root-panel">
    <left>
        <VBox styleClass="sidebar" minWidth="260.0" prefWidth="280.0" maxWidth="320.0">
            <HBox styleClass="sidebar-header" alignment="CENTER_LEFT" spacing="8.0">
                <Label text="%app.name" styleClass="app-title"/>
            </HBox>
            <TextField fx:id="searchField" promptText="%search.prompt" styleClass="search-field"/>
            <ListView fx:id="chatListView" styleClass="chat-list" VBox.vgrow="ALWAYS"/>
            <Button text="%add.contact" onAction="#onAddContactClicked"
                    styleClass="accent-button" maxWidth="Infinity" mnemonicParsing="false"/>
            <Label text="%rooms.title" styleClass="label-caption" maxWidth="Infinity"/>
            <ListView fx:id="roomsListView" styleClass="chat-list" prefHeight="140.0" maxHeight="220.0"/>
            <Button text="%rooms.new" onAction="#onNewRoomClicked"
                    styleClass="ghost-button" maxWidth="Infinity" mnemonicParsing="false"/>
            <Button text="%nav.requests" onAction="#onShowRequestsClicked"
                    styleClass="ghost-button" maxWidth="Infinity" mnemonicParsing="false"/>
            <HBox spacing="8.0">
                <Button text="%nav.my_number" onAction="#onShowIdentityClicked"
                        styleClass="ghost-button" HBox.hgrow="ALWAYS" maxWidth="Infinity" mnemonicParsing="false"/>
                <Button text="%nav.settings" onAction="#onShowSettingsClicked"
                        styleClass="ghost-button" HBox.hgrow="ALWAYS" maxWidth="Infinity" mnemonicParsing="false"/>
            </HBox>
        </VBox>
    </left>
    <center>
        <StackPane fx:id="contentStack" styleClass="content-panel"/>
    </center>
</BorderPane>
